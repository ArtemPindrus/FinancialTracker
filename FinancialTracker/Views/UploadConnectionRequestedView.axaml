<UserControl
    x:Class="FinancialTracker.Views.UploadConnectionRequestedView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FinancialTracker.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:UploadConnectionRequestedViewModel"
    mc:Ignorable="d">
    <StackPanel>
        <TextBlock Text="{Binding IpAddress, StringFormat='Incoming connection from: {0}'}" />

        <StackPanel Orientation="Horizontal">
            <Button Command="{Binding RejectCommand}" Content="Reject" />
            <Button Command="{Binding AcceptCommand}" Content="Accept" />
        </StackPanel>

        <Button Command="{Binding StopServerCommand}" Content="Stop server" />
    </StackPanel>
</UserControl>
