<UserControl
    x:Class="FinancialTracker.Views.UploadConnectionRequestedView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FinancialTracker.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:UploadConnectionRequestedViewModel"
    mc:Ignorable="d">
    <StackPanel Width="320" Spacing="16">
        <TextBlock
            FontSize="16"
            FontWeight="SemiBold"
            Text="Connection Request" />

        <TextBlock
            FontSize="13"
            Text="{Binding IpAddress, StringFormat='Incoming connection from: {0}'}"
            TextAlignment="Center"
            TextWrapping="Wrap" />

        <StackPanel
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                Width="120"
                Padding="12,8"
                Command="{Binding RejectCommand}"
                Content="Reject"
                FontSize="12" />
            <Button
                Width="120"
                Padding="12,8"
                Command="{Binding AcceptCommand}"
                Content="Accept"
                FontSize="12"
                IsDefault="True" />
        </StackPanel>

        <Button
            Padding="12,8"
            Command="{Binding StopServerCommand}"
            Content="Stop Server"
            FontSize="12" />
    </StackPanel>
</UserControl>
