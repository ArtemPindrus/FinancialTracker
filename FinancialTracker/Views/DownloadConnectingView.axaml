<UserControl
    x:Class="FinancialTracker.Views.DownloadConnectingView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FinancialTracker.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:DownloadConnectingViewModel"
    mc:Ignorable="d">
    <StackPanel>
        <TextBlock Text="{Binding IpAddress, StringFormat='Connecting to: {0}'}" />
        <Button Command="{Binding CancelCommand}" Content="Cancel" />
    </StackPanel>
</UserControl>
