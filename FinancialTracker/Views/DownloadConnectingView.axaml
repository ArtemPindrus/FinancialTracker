<UserControl
    x:Class="FinancialTracker.Views.DownloadConnectingView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    xmlns:vm="using:FinancialTracker.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:DownloadConnectingViewModel"
    mc:Ignorable="d">
    <StackPanel Width="300" Spacing="16">
        <TextBlock
            FontSize="16"
            FontWeight="SemiBold"
            Text="Connecting..." />

        <ui:ProgressRing IsIndeterminate="True" />

        <TextBlock
            FontSize="13"
            Text="{Binding IpAddress, StringFormat='Connecting to: {0}'}"
            TextAlignment="Center"
            TextWrapping="Wrap" />

        <Button
            Padding="12,8"
            Command="{Binding CancelCommand}"
            Content="Cancel" />
    </StackPanel>
</UserControl>
