<UserControl
    x:Class="FinancialTracker.Views.DownloadReceivingView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    xmlns:vm="using:FinancialTracker.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:DownloadReceivingViewModel"
    mc:Ignorable="d">
    <StackPanel Width="300" Spacing="16">
        <TextBlock
            FontSize="16"
            FontWeight="SemiBold"
            Text="Receiving Data"
            TextAlignment="Center" />

        <ui:ProgressRing
            Width="80"
            Height="80"
            HorizontalAlignment="Center"
            IsIndeterminate="False"
            Value="{Binding Progress}" />
    </StackPanel>
</UserControl>
