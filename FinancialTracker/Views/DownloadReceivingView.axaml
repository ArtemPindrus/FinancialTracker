<UserControl
    x:Class="FinancialTracker.Views.DownloadReceivingView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    xmlns:vm="using:FinancialTracker.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:DownloadReceivingViewModel"
    mc:Ignorable="d">
    <ui:ProgressRing IsIndeterminate="False" Value="{Binding Progress}" />
</UserControl>
