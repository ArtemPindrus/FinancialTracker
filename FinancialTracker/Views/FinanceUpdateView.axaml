<UserControl
    x:Class="FinancialTracker.Views.FinanceUpdateView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FinancialTracker.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:FinanceUpdateViewModel"
    mc:Ignorable="d">
    <StackPanel Orientation="Vertical">
        <TextBox PlaceholderText="Record name" Text="{Binding Name}" />
        <TextBox PlaceholderText="Amount" Text="{Binding Amount}" />
        <TextBox PlaceholderText="Date" Text="{Binding Date, UpdateSourceTrigger=LostFocus}" />
        <CheckBox Content="Is Deleted" IsChecked="{Binding IsDeleted}" />

        <StackPanel Orientation="Horizontal">
            <Button Command="{Binding SaveCommand}" Content="Save" />
            <Button Command="{Binding RevertCommand}" Content="Revert" />
        </StackPanel>
    </StackPanel>
</UserControl>
