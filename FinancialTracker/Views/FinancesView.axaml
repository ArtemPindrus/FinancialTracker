<UserControl
    x:Class="FinancialTracker.Views.FinancesView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FinancialTracker.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:FinancialTracker.Models"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    xmlns:viewmodels="using:FinancialTracker.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="viewmodels:FinancesViewModel"
    mc:Ignorable="d">
    <NavigationPage Name="NavigationPage">
        <ContentPage>
            <Grid RowDefinitions="Auto, *">
                <StackPanel Orientation="Horizontal">
                    <Button
                        Command="{Binding SendSaveRequestCommand}"
                        Content="Save"
                        HotKey="Ctrl+S"
                        ToolTip.Tip="Save changes. (Ctrl+S)" />
                    <Button
                        Command="{Binding AddDefaultRecordCommand}"
                        Content="Add"
                        ToolTip.Tip="Add new record." />

                    <Button
                        Command="{Binding RollbackCommand}"
                        Content="Reload"
                        ToolTip.Tip="Reload data from database. Undoes changes." />
                </StackPanel>

                <!--  Undo/Redo  -->
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button
                        Command="{Binding UndoCommand}"
                        HotKey="Ctrl+Z"
                        ToolTip.Tip="Undo last change. (Ctrl+Z)">
                        <ui:FAFontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE10E;" />
                    </Button>
                    <Button
                        Command="{Binding RedoCommand}"
                        HotKey="Ctrl+Y"
                        ToolTip.Tip="Redo last change. (Ctrl+Y)">
                        <ui:FAFontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE10D;" />
                    </Button>
                </StackPanel>

                <TableView
                    x:Name="Table"
                    Grid.Row="1"
                    ItemsSource="{Binding Finances}"
                    SelectedItems="{Binding SelectedFinances}"
                    SelectionMode="Multiple">
                    <TableView.Styles>
                        <Style Selector="TableViewRow">
                            <Setter Property="ContextFlyout">
                                <MenuFlyout>
                                    <MenuFlyout.Items>
                                        <MenuItem Command="{Binding #Table.DataContext.MarkRecordDeletedCommand}" Header="Delete" />
                                        <MenuItem Header="Add tag" ItemsSource="{Binding #Table.DataContext.AddTagsMenuItems}" />
                                        <MenuItem Header="Remove tag" ItemsSource="{Binding #Table.DataContext.RemoveTagsMenuItems}" />
                                    </MenuFlyout.Items>
                                </MenuFlyout>
                            </Setter>

                            <Setter Property="Interaction.Behaviors">
                                <BehaviorCollectionTemplate>
                                    <BehaviorCollection>
                                        <EventTriggerBehavior EventName="DoubleTapped">
                                            <InvokeCommandAction Command="{Binding #Table.DataContext.OpenFinanceUpdateCommand}" CommandParameter="{Binding}" />
                                        </EventTriggerBehavior>
                                    </BehaviorCollection>
                                </BehaviorCollectionTemplate>
                            </Setter>

                            <Setter x:DataType="models:FinanceRecordDto" Property="Classes.IsDisabled" Value="{Binding IsDeleted}" />
                        </Style>

                        <Style Selector="TableViewRow.IsDisabled">
                            <Setter Property="Foreground" Value="Gray" />
                        </Style>
                    </TableView.Styles>

                    <TableView.Columns>
                        <TableViewColumn
                            Width="60"
                            x:DataType="models:FinanceRecordDto"
                            Binding="{Binding Id}"
                            Header="Id" />
                        <TableViewColumn
                            x:DataType="models:FinanceRecordDto"
                            Binding="{Binding Name, UpdateSourceTrigger=LostFocus}"
                            Header="Name" />
                        <TableViewColumn
                            x:DataType="models:FinanceRecordDto"
                            Binding="{Binding Amount, UpdateSourceTrigger=LostFocus}"
                            Header="Amount" />
                        <TableViewColumn
                            x:DataType="models:FinanceRecordDto"
                            Binding="{Binding Date, UpdateSourceTrigger=LostFocus}"
                            Header="Date" />
                        <TableViewColumn Header="Tags">
                            <TableViewColumn.CellTemplate>
                                <DataTemplate DataType="models:FinanceRecordDto">
                                    <ItemsControl ItemsSource="{Binding Tags}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel ItemSpacing="3" LineSpacing="3" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Padding="5"
                                                    VerticalAlignment="Center"
                                                    Background="Gray"
                                                    CornerRadius="5">
                                                    <TextBlock Text="{Binding}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </TableViewColumn.CellTemplate>
                        </TableViewColumn>
                    </TableView.Columns>
                </TableView>
            </Grid>
        </ContentPage>
    </NavigationPage>
</UserControl>
