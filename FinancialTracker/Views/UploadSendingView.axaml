<UserControl
    x:Class="FinancialTracker.Views.UploadSendingView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FinancialTracker.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:UploadSendingViewModel"
    mc:Ignorable="d">
    <StackPanel Width="320" Spacing="16">
        <TextBlock
            FontSize="16"
            FontWeight="SemiBold"
            Text="Sending Database" />

        <TextBlock
            FontSize="13"
            Text="{Binding IpAddress, StringFormat='Sending to: {0}'}"
            TextAlignment="Center"
            TextWrapping="Wrap" />

        <Separator Height="1" Margin="0,4,0,4" />

        <StackPanel
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                Width="150"
                Padding="12,8"
                Command="{Binding DisconnectCommand}"
                Content="Disconnect"
                FontSize="12" />
            <Button
                Width="150"
                Padding="12,8"
                Command="{Binding StopServerCommand}"
                Content="Stop Server"
                FontSize="12" />
        </StackPanel>
    </StackPanel>
</UserControl>
