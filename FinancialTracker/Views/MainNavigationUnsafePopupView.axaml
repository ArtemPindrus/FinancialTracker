<UserControl
    x:Class="FinancialTracker.Views.MainNavigationUnsafePopupView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FinancialTracker.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:MainNavigationUnsafePopupViewModel"
    mc:Ignorable="d">
    <Grid Margin="5" RowDefinitions="*, Auto">
        <TextBlock
            VerticalAlignment="Center"
            Text="{Binding Message}"
            TextWrapping="Wrap" />

        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button Command="{Binding CancelCommand}" Content="Cancel" />
            <Button Command="{Binding ContinueCommand}" Content="Continue" />
        </StackPanel>
    </Grid>
</UserControl>
