<UserControl
    x:Class="FinancialTracker.Views.UploadIdleView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FinancialTracker.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:UploadIdleViewModel"
    mc:Ignorable="d">
    <StackPanel
        Width="300"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Spacing="12">
        <TextBlock
            FontSize="16"
            FontWeight="SemiBold"
            Text="Upload Server"
            TextAlignment="Center" />

        <TextBlock
            FontSize="12"
            Text="Start a server to send database to another device"
            TextAlignment="Center"
            TextWrapping="Wrap" />

        <Button
            Padding="12,8"
            Command="{Binding StartServerCommand}"
            Content="Start Server"
            FontSize="13"
            IsDefault="True" />
    </StackPanel>
</UserControl>
