<UserControl
    x:Class="FinancialTracker.Views.DownloadConnectedView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FinancialTracker.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:DownloadConnectedViewModel"
    mc:Ignorable="d">
    <StackPanel Width="300" Spacing="16">
        <TextBlock
            FontSize="16"
            FontWeight="SemiBold"
            Text="Connected" />

        <TextBlock
            FontSize="13"
            Text="{Binding IpAddress, StringFormat='Connected to: {0}'}"
            TextAlignment="Center"
            TextWrapping="Wrap" />

        <Button
            Padding="12,8"
            Command="{Binding DisconnectCommand}"
            Content="Disconnect"
            FontSize="13" />
    </StackPanel>
</UserControl>
