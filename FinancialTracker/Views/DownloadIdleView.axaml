<UserControl
    x:Class="FinancialTracker.Views.DownloadIdleView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FinancialTracker.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:DownloadIdleViewModel"
    mc:Ignorable="d">
    <StackPanel Width="300" Spacing="12">
        <TextBlock
            FontSize="16"
            FontWeight="SemiBold"
            Text="Connect to Server" />

        <TextBox
            Padding="12,10"
            FontSize="13"
            Text="{Binding IpAddress}"
            Watermark="Server IP (e.g., 192.168.1.100)" />

        <Button
            Padding="12,8"
            Command="{Binding ConnectCommand}"
            Content="Connect"
            FontSize="13"
            IsDefault="True" />
    </StackPanel>
</UserControl>
