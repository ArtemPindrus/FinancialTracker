<UserControl
    x:Class="FinancialTracker.Views.MainView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FinancialTracker.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogHost="using:DialogHostAvalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    xmlns:vm="using:FinancialTracker.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:MainViewModel"
    mc:Ignorable="d">
    <Design.DataContext>
        <!--
            This only sets the DataContext for the previewer in an IDE,
            to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs)
        -->
        <vm:MainViewModel />
    </Design.DataContext>

    <dialogHost:DialogHost Identifier="MainDialogHost">
        <ui:NavigationView
            IsSettingsVisible="False"
            OpenPaneLength="200"
            PaneDisplayMode="Left"
            SelectedItem="{Binding SelectedNavigationItem}">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Finances" />
                <ui:NavigationViewItem Content="Raw Query" />
                <ui:NavigationViewItem Content="Charts" SelectsOnInvoked="False">
                    <ui:NavigationViewItem.MenuItems>
                        <ui:NavigationViewItem Content="Yearly Expenses" />
                    </ui:NavigationViewItem.MenuItems>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Sync" SelectsOnInvoked="False">
                    <ui:NavigationViewItem.MenuItems>
                        <ui:NavigationViewItem Content="Upload" />
                        <ui:NavigationViewItem Content="Download" />
                    </ui:NavigationViewItem.MenuItems>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <dialogHost:DialogHost Identifier="ContentDialogHost">
                <Grid RowDefinitions="*, Auto">
                    <ContentControl Content="{Binding ViewModel}" />

                    <ContentControl Grid.Row="1" Content="{Binding InfoBar}" />
                </Grid>
            </dialogHost:DialogHost>
        </ui:NavigationView>
    </dialogHost:DialogHost>

</UserControl>
